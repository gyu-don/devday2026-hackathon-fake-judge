{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "judge": {
      "enum": [
        "devday-judge-evidence",
        "devday-judge-journey",
        "devday-judge-challenge"
      ]
    },
    "rubric_version": {
      "const": "2.0"
    },
    "target": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "enum": [
            "working_tree",
            "commit"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "changed_during_review": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "commit",
        "scope",
        "dirty",
        "changed_during_review"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "enum": [
        "scored",
        "partial",
        "unavailable"
      ]
    },
    "summary": {
      "type": "string"
    },
    "criteria": {
      "type": "object",
      "properties": {
        "new_feature": {
          "$ref": "#/$defs/criterion"
        },
        "usability": {
          "$ref": "#/$defs/criterion"
        },
        "utility": {
          "$ref": "#/$defs/criterion"
        },
        "originality": {
          "$ref": "#/$defs/criterion"
        }
      },
      "required": [
        "new_feature",
        "usability",
        "utility",
        "originality"
      ],
      "additionalProperties": false
    },
    "total": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 40
    },
    "max_total": {
      "const": 40
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "code",
              "test",
              "docs",
              "asset",
              "metadata"
            ]
          },
          "basis": {
            "enum": [
              "observed",
              "claimed",
              "inferred"
            ]
          },
          "observation": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "locator",
          "kind",
          "basis",
          "observation"
        ],
        "additionalProperties": false
      }
    },
    "review_scope": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "static_only"
        },
        "inspected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "omitted_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution": {
          "const": "not_run"
        }
      },
      "required": [
        "mode",
        "inspected_paths",
        "omitted_areas",
        "execution"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrity_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "handling": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "locator",
          "issue",
          "handling"
        ],
        "additionalProperties": false
      }
    },
    "follow_up_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feature_use": {
      "type": "object",
      "properties": {
        "reference_version": {
          "const": "devday-2026-v2.0"
        },
        "source_url": {
          "const": "https://openai.com/index/devday-2026-recap/"
        },
        "counterfactual": {
          "type": "string",
          "minLength": 1
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mapping"
          }
        }
      },
      "required": [
        "reference_version",
        "source_url",
        "counterfactual",
        "mappings"
      ],
      "additionalProperties": false
    },
    "method_observations": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidence_method"
        },
        {
          "$ref": "#/$defs/journey_method"
        },
        {
          "$ref": "#/$defs/challenge_method"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "judge",
    "rubric_version",
    "target",
    "assessment",
    "summary",
    "criteria",
    "total",
    "max_total",
    "evidence",
    "review_scope",
    "limitations",
    "integrity_flags",
    "follow_up_questions",
    "feature_use",
    "method_observations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "criterion": {
      "type": "object",
      "properties": {
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "score",
        "confidence",
        "reason",
        "strengths",
        "gaps",
        "unknowns",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "announcement_id": {
          "type": "string",
          "pattern": "^DD(0[1-9]|1[0-9]|2[0-5])$"
        },
        "announcement": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "enum": [
            "core",
            "supporting",
            "development_only",
            "inspiration",
            "mention_only"
          ]
        },
        "basis": {
          "enum": [
            "product_use",
            "experience_application",
            "concept_only"
          ]
        },
        "implementation": {
          "enum": [
            "connected",
            "implemented_unverified",
            "mock",
            "planned",
            "not_applicable"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "contribution": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "announcement_id",
        "announcement",
        "relationship",
        "basis",
        "implementation",
        "evidence_ids",
        "contribution"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "finding",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "affected_criteria": {
          "type": "array",
          "items": {
            "enum": [
              "new_feature",
              "usability",
              "utility",
              "originality"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "trigger",
        "scope",
        "finding",
        "evidence_ids",
        "affected_criteria"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "claim",
              "evidence_ids"
            ],
            "additionalProperties": false
          }
        },
        "inspected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "required": [
        "claims",
        "inspected_paths",
        "missing_evidence",
        "contradictions"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "enum": [
            "connected",
            "implemented_unverified",
            "mock",
            "planned",
            "not_applicable"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "affected_criteria": {
          "type": "array",
          "items": {
            "enum": [
              "new_feature",
              "usability",
              "utility",
              "originality"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "stage",
        "path",
        "locator",
        "observation",
        "implementation",
        "evidence_ids",
        "affected_criteria"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "scenario_type": {
          "enum": [
            "normal",
            "exception"
          ]
        },
        "selection_basis": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "breaks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "user",
        "goal",
        "scenario_type",
        "selection_basis",
        "steps",
        "breaks",
        "outcome"
      ],
      "additionalProperties": false
    },
    "claim_test": {
      "type": "object",
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "counter_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "discriminating_check": {
          "type": "string",
          "minLength": 1
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "opposing_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "alternative_explanations_checked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result": {
          "enum": [
            "supported",
            "refuted",
            "mixed",
            "unresolved"
          ]
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "affected_criteria": {
          "type": "array",
          "items": {
            "enum": [
              "new_feature",
              "usability",
              "utility",
              "originality"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "claim",
        "counter_hypothesis",
        "discriminating_check",
        "supporting_evidence_ids",
        "opposing_evidence_ids",
        "alternative_explanations_checked",
        "result",
        "finding",
        "affected_criteria"
      ],
      "additionalProperties": false
    },
    "evidence_method": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "evidence"
        },
        "coverage": {
          "type": "object",
          "properties": {
            "new_feature": {
              "$ref": "#/$defs/coverage"
            },
            "usability": {
              "$ref": "#/$defs/coverage"
            },
            "utility": {
              "$ref": "#/$defs/coverage"
            },
            "originality": {
              "$ref": "#/$defs/coverage"
            }
          },
          "required": [
            "new_feature",
            "usability",
            "utility",
            "originality"
          ],
          "additionalProperties": false
        },
        "additional_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "completion_check": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "coverage",
        "additional_checks",
        "completion_check"
      ],
      "additionalProperties": false
    },
    "journey_method": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "journey"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          }
        },
        "supplemental_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "completion_check": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "scenarios",
        "supplemental_checks",
        "completion_check"
      ],
      "additionalProperties": false
    },
    "challenge_method": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "challenge"
        },
        "claim_tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim_test"
          }
        },
        "additional_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "completion_check": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "claim_tests",
        "additional_checks",
        "completion_check"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "judge": {
            "const": "devday-judge-evidence"
          }
        },
        "required": [
          "judge"
        ]
      },
      "then": {
        "properties": {
          "method_observations": {
            "$ref": "#/$defs/evidence_method"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judge": {
            "const": "devday-judge-journey"
          }
        },
        "required": [
          "judge"
        ]
      },
      "then": {
        "properties": {
          "method_observations": {
            "$ref": "#/$defs/journey_method"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judge": {
            "const": "devday-judge-challenge"
          }
        },
        "required": [
          "judge"
        ]
      },
      "then": {
        "properties": {
          "method_observations": {
            "$ref": "#/$defs/challenge_method"
          }
        }
      }
    }
  ]
}
