{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "judge": {
      "enum": [
        "devday-judge-evidence",
        "devday-judge-journey",
        "devday-judge-challenge"
      ]
    },
    "rubric_version": {
      "const": "1.1"
    },
    "target": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "enum": [
            "working_tree",
            "commit"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "changed_during_review": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "commit",
        "scope",
        "dirty",
        "changed_during_review"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "enum": [
        "scored",
        "partial",
        "unavailable"
      ]
    },
    "summary": {
      "type": "string"
    },
    "criteria": {
      "type": "object",
      "properties": {
        "technical": {
          "type": "object",
          "properties": {
            "score": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "reason": {
              "type": "string"
            },
            "strengths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unknowns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "score",
            "confidence",
            "reason",
            "strengths",
            "gaps",
            "unknowns",
            "evidence_ids"
          ],
          "additionalProperties": false
        },
        "ux": {
          "type": "object",
          "properties": {
            "score": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "reason": {
              "type": "string"
            },
            "strengths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unknowns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "score",
            "confidence",
            "reason",
            "strengths",
            "gaps",
            "unknowns",
            "evidence_ids"
          ],
          "additionalProperties": false
        },
        "impact": {
          "type": "object",
          "properties": {
            "score": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "reason": {
              "type": "string"
            },
            "strengths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unknowns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "score",
            "confidence",
            "reason",
            "strengths",
            "gaps",
            "unknowns",
            "evidence_ids"
          ],
          "additionalProperties": false
        },
        "idea": {
          "type": "object",
          "properties": {
            "score": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 10
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "reason": {
              "type": "string"
            },
            "strengths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unknowns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "score",
            "confidence",
            "reason",
            "strengths",
            "gaps",
            "unknowns",
            "evidence_ids"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "technical",
        "ux",
        "impact",
        "idea"
      ],
      "additionalProperties": false
    },
    "total": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 40
    },
    "max_total": {
      "const": 40
    },
    "theme": {
      "type": "object",
      "properties": {
        "reference_version": {
          "const": "devday-2026-v1.1"
        },
        "source_url": {
          "const": "https://openai.com/index/devday-2026-recap/"
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "max_score": {
          "const": 10
        },
        "match": {
          "enum": [
            "mismatch",
            "weak",
            "partial",
            "strong",
            "undetermined"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "reason": {
          "type": "string"
        },
        "counterfactual": {
          "type": "string"
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "announcement_id": {
                "type": "string",
                "pattern": "^DD(0[1-9]|1[0-9]|2[0-5])$"
              },
              "announcement": {
                "type": "string"
              },
              "relationship": {
                "enum": [
                  "core",
                  "supporting",
                  "development_only",
                  "inspiration",
                  "mention_only"
                ]
              },
              "basis": {
                "enum": [
                  "product_use",
                  "experience_application",
                  "concept_only"
                ]
              },
              "implementation": {
                "enum": [
                  "connected",
                  "implemented_unverified",
                  "mock",
                  "planned",
                  "not_applicable"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "contribution": {
                "type": "string"
              }
            },
            "required": [
              "announcement_id",
              "announcement",
              "relationship",
              "basis",
              "implementation",
              "evidence_ids",
              "contribution"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "reference_version",
        "source_url",
        "score",
        "max_score",
        "match",
        "confidence",
        "reason",
        "counterfactual",
        "mappings"
      ],
      "additionalProperties": false
    },
    "event_policy": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "eligibility": {
          "enum": [
            "not_specified",
            "met",
            "not_met",
            "undetermined"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "rules",
        "eligibility",
        "reason"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "code",
              "test",
              "docs",
              "asset",
              "metadata"
            ]
          },
          "basis": {
            "enum": [
              "observed",
              "claimed",
              "inferred"
            ]
          },
          "observation": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "locator",
          "kind",
          "basis",
          "observation"
        ],
        "additionalProperties": false
      }
    },
    "review_scope": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "static_only"
        },
        "inspected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "omitted_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution": {
          "const": "not_run"
        }
      },
      "required": [
        "mode",
        "inspected_paths",
        "omitted_areas",
        "execution"
      ],
      "additionalProperties": false
    },
    "method_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrity_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "handling": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "locator",
          "issue",
          "handling"
        ],
        "additionalProperties": false
      }
    },
    "follow_up_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "judge",
    "rubric_version",
    "target",
    "assessment",
    "summary",
    "criteria",
    "total",
    "max_total",
    "theme",
    "event_policy",
    "evidence",
    "review_scope",
    "method_notes",
    "limitations",
    "integrity_flags",
    "follow_up_questions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
